# Rename this file to .env and fill in your values

# Required
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Optional but recommended
MANNCO_COOKIE=your-mannco-cookie-here

# Debug mode (set to true to enable more verbose logging)
DEBUG=false

# Server Configuration
PORT=3000
CHECK_INTERVAL_MS=300000  # 5 minutes

# Steam Bot IDs for Inventory API (comma separated)
STEAM_BOT_IDS=76561198834107391,76561198833863935,76561198833968561,76561198833993841
